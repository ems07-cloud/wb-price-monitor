# Токен бота от @BotFather
TELEGRAM_TOKEN=

# База данных (по умолчанию SQLite рядом с проектом)
DATABASE_URL=sqlite:///./monitor.db

# Как часто обходить отслеживаемые товары, минут
COLLECT_INTERVAL_MINUTES=15

# Уведомлять об изменении цены, если она сдвинулась хотя бы на столько процентов
PRICE_ALERT_MIN_PERCENT=1

# Сколько ждать ответа WB по одному товару, секунд
WB_BROWSER_TIMEOUT_SEC=40

# true — показать окно браузера (для отладки)
WB_SHOW_BROWSER=false
